# Copy to .env and adjust as needed. Never commit the real .env file.

# FastAPI service (scripts/run_api.py)
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit dashboard (src/dashboard/app.py)
DASHBOARD_API_URL=http://127.0.0.1:8000

# Local language model used by the RAG assistant (Ollama)
OLLAMA_MODEL=llama3.2:1b
